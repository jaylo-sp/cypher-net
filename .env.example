# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase dashboard: Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Your admin email. When you sign in with this email, the Administrator
# role unlocks automatically (no PIN needed) and you can approve profile
# claims + manage judge invitations. The same email must appear in
# `supabase-schema.sql` policies for `profile_claims` and `judge_grants`.
VITE_ADMIN_EMAIL=you@example.com
